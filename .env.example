# --- Vera agent wallet (server-side ONLY) ---
# Generate with: node scripts/generate-devnet-wallet.mjs
SOLANA_PRIVATE_KEY=
# Merchant / payTo recipient (can be the same pubkey for a self-contained demo)
SOLANA_PAY_TO=

# --- x402 ---
FACILITATOR_URL=https://x402.org/facilitator
# Max USDC the x402 client will authorize (defense in depth)
VERA_MAX_PAYMENT_USD=0.10

# --- Paid provider ---
PROVIDER_PORT=4021
PROVIDER_BASE_URL=http://127.0.0.1:4021

# Optional Solana RPC override
# SOLANA_RPC_URL=https://api.devnet.solana.com
